{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agf-atende-api",
  "main": "src/table-controls-wrapper.js",
  "compatibility_date": "2026-09-05",
  "limits": {
    "cpu_ms": 300000
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agf-atende",
      "database_id": "868ad2d8-2083-449a-bd09-97b2bf27120f",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "v6test": {
      "name": "agf-atende-api-v6test",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agf-atende-v6",
          "database_id": "a98c0716-ff8d-43dd-9cab-7ae9e8317c3d",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
