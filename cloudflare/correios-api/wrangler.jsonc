{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agf-correios-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-03",
  "vars": {
    "ALLOWED_ORIGINS": "https://minhaagenciaonline.com.br,https://www.minhaagenciaonline.com.br,http://localhost:8788,http://127.0.0.1:8788"
  },
  // Secrets (wrangler secret put): ENCRYPTION_KEY, INTERNAL_KEY
  "triggers": { "crons": ["17 6 * * *"] },
  "services": [
    { "binding": "AGF_CORE", "service": "agf-core-api" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agf-correios",
      "database_id": "3b74710c-c91f-47b9-80c3-434965d49b72",
      "migrations_dir": "migrations"
    }
  ]
}
