{
  // agf-cadastros-api v2 - substitui o codigo da v1 no mesmo Worker (mesmo nome, mesmo endereco)
  "name": "agf-cadastros-api",
  "main": "src/index.js",
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "d1_databases": [
    { "binding": "DB", "database_name": "agf-cadastros", "database_id": "39a4982e-cc07-4feb-9f76-bc7b6c645f7f", "migrations_dir": "migrations" },
    { "binding": "ATENDE_DB", "database_name": "agf-atende", "database_id": "868ad2d8-2083-449a-bd09-97b2bf27120f" }
  ],
  "vars": {
    "AGF_AUTH_API_URL": "https://script.google.com/macros/s/AKfycbxv_3OLKyy13PqtEdqnVSA2zg3xljaU5gAKgn-TIVaaSRaTNPGgWIaRvDV_JuT9PTc5/exec",
    "ALLOWED_ORIGINS": "https://minhaagenciaonline.com.br,https://www.minhaagenciaonline.com.br,https://feature-cadastros-v2.minhaagenciaonline.pages.dev",
    "PREVIEW_ORIGIN_SUFFIX": ""
  },
  // sincroniza o Atende a cada 10 min; a limpeza roda sozinha ao fim de cada passagem com mudanca
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
