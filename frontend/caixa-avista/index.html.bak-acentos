<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,maximum-scale=1,user-scalable=no">
  <meta name="theme-color" content="#0f6ee8">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <title>Caixa Ã  Vista | AGF JosÃ© BonifÃ¡cio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,600,1,0" rel="stylesheet">
  <link rel="stylesheet" href="/caixa-avista/styles-v2.css">
  <link rel="manifest" href="/caixa-avista/manifest.webmanifest">
  <script src="/shared/auth/agf-auth-config.js"></script>
  <script src="/shared/auth/agf-auth-client.js"></script>
  <script>window.AGF_ACCESS={roles:['admin','manager','user'],app:'caixa'};</script>
  <script src="/shared/auth/agf-route-guard.js"></script>
</head>
<body data-entry-type="RECEITA">
  <div class="app-shell">
    <header class="topbar-shell">
      <div class="topbar">
        <div class="brand">
          <div class="brand-mark"><span class="material-symbols-rounded">point_of_sale</span></div>
          <div class="brand-copy"><h1>Caixa Ã  Vista</h1><p id="unitLabel">Carregando...</p></div>
        </div>
        <div class="top-actions">
          <button class="icon-btn" id="btnRefresh" type="button" title="Atualizar" aria-label="Atualizar"><span class="material-symbols-rounded">refresh</span></button>
          <button class="icon-btn" id="btnSettings" type="button" title="ConfiguraÃ§Ã£o local" aria-label="ConfiguraÃ§Ã£o local"><span class="material-symbols-rounded">settings</span></button>
        </div>
      </div>
    </header>

    <main class="page">
      <section class="identity-strip">
        <div><span class="material-symbols-rounded">badge</span><strong id="operatorLabel">UsuÃ¡rio</strong></div>
        <div><span class="material-symbols-rounded">calendar_today</span><strong id="dateLabel">--/--/----</strong></div>
      </section>

      <section class="cash-strip">
        <div class="cash-stat"><span class="material-symbols-rounded">account_balance_wallet</span><small>Inicial</small><strong id="cashOpening">R$ 0,00</strong></div>
        <div class="cash-stat main"><span class="material-symbols-rounded">payments</span><small>Em caixa</small><strong id="cashExpected">R$ 0,00</strong></div>
        <div class="cash-stat"><span class="material-symbols-rounded">outbox</span><small>Sangrias</small><strong id="cashWithdrawals">R$ 0,00</strong></div>
        <button class="cash-action" id="btnOpenWithdrawal" type="button" title="Nova sangria" aria-label="Nova sangria"><span class="material-symbols-rounded">move_up</span></button>
      </section>

      <nav class="main-nav">
        <button class="main-nav-btn active" type="button" data-view="launch"><span class="material-symbols-rounded">add_circle</span><small>LanÃ§ar</small></button>
        <button class="main-nav-btn" type="button" data-view="movements"><span class="material-symbols-rounded">receipt_long</span><small>Mov.</small></button>
        <button class="main-nav-btn" type="button" data-view="close"><span class="material-symbols-rounded">fact_check</span><small>Fechar</small></button>
      </nav>

      <section id="viewLaunch" class="view-panel">
        <div class="type-switch">
          <button class="type-btn revenue active" type="button" data-entry-type="RECEITA"><span class="material-symbols-rounded">add_circle</span><span>Receita</span></button>
          <button class="type-btn expense" type="button" data-entry-type="DESPESA"><span class="material-symbols-rounded">remove_circle</span><span>Despesa</span></button>
        </div>

        <section class="card launch-card">
          <div class="mode-switch" id="modeSwitch"></div>
          <div class="card-body">
            <div class="option-section">
              <div class="compact-label"><span class="material-symbols-rounded">category</span><span id="categoryLabel">Tipo</span></div>
              <div class="icon-options" id="categoryOptions"></div>
            </div>

            <div class="option-section">
              <div class="compact-label"><span class="material-symbols-rounded">payments</span><span>Pagamento</span></div>
              <div class="icon-options payments" id="paymentOptions"></div>
            </div>

            <div id="clientSection" class="option-section">
              <div class="client-row">
                <div class="client-box"><span class="material-symbols-rounded">person_search</span><input id="clientInput" autocomplete="off" placeholder="Cliente"></div>
                <button id="btnAddClient" class="square-btn teal" type="button" title="Cadastrar cliente" disabled><span class="material-symbols-rounded">person_add</span></button>
              </div>
              <div id="clientSuggestions" class="suggestions hidden"></div>
              <div id="clientChip" class="selected-chip hidden"></div>
            </div>

            <div id="singleFields">
              <div class="minor-grid">
                <div id="objectSection" class="minor-box">
                  <span class="minor-title"><span class="material-symbols-rounded">inventory_2</span>Objetos</span>
                  <div class="counter"><button id="btnObjectMinus" type="button"><span class="material-symbols-rounded">remove</span></button><strong id="objectCount">1</strong><button id="btnObjectPlus" type="button"><span class="material-symbols-rounded">add</span></button></div>
                </div>
                <div class="minor-box description-box">
                  <span class="minor-title"><span class="material-symbols-rounded">edit_note</span>Obs.</span>
                  <input id="descriptionInput" placeholder="Opcional">
                </div>
              </div>

              <div class="amount-card"><small>Valor</small><strong id="amountDisplay">R$ 0,00</strong></div>
              <div class="keypad" id="keypad">
                <button type="button" data-key="1">1</button><button type="button" data-key="2">2</button><button type="button" data-key="3">3</button>
                <button type="button" data-key="4">4</button><button type="button" data-key="5">5</button><button type="button" data-key="6">6</button>
                <button type="button" data-key="7">7</button><button type="button" data-key="8">8</button><button type="button" data-key="9">9</button>
                <button type="button" class="utility" data-key="clear"><span class="material-symbols-rounded">delete_sweep</span></button><button type="button" data-key="0">0</button><button type="button" class="utility" data-key="backspace"><span class="material-symbols-rounded">backspace</span></button>
              </div>
              <button id="btnSaveSingle" class="primary-action" type="button"><span class="material-symbols-rounded">check_circle</span><span>Registrar</span></button>
            </div>

            <div id="batchFields" class="hidden">
              <div class="batch-entry-row">
                <div class="batch-amount"><small>Novo valor</small><strong id="batchAmountDisplay">R$ 0,00</strong></div>
                <button id="btnAddBatchItem" class="batch-add" type="button" aria-label="Adicionar ao lote"><span class="material-symbols-rounded">add</span></button>
              </div>
              <div class="keypad batch" id="batchKeypad">
                <button type="button" data-key="1">1</button><button type="button" data-key="2">2</button><button type="button" data-key="3">3</button>
                <button type="button" data-key="4">4</button><button type="button" data-key="5">5</button><button type="button" data-key="6">6</button>
                <button type="button" data-key="7">7</button><button type="button" data-key="8">8</button><button type="button" data-key="9">9</button>
                <button type="button" class="utility" data-key="clear"><span class="material-symbols-rounded">delete_sweep</span></button><button type="button" data-key="0">0</button><button type="button" class="utility" data-key="backspace"><span class="material-symbols-rounded">backspace</span></button>
              </div>
              <div class="batch-total"><div><span class="material-symbols-rounded">format_list_numbered</span><strong id="batchCount">0</strong></div><div><span class="material-symbols-rounded">calculate</span><strong id="batchTotal">R$ 0,00</strong></div></div>
              <div id="batchItems" class="batch-items"></div>
              <button id="btnSaveBatch" class="primary-action" type="button"><span class="material-symbols-rounded">playlist_add_check</span><span>Fechar lote</span></button>
            </div>
            <div id="launchStatus" class="status-box"></div>
          </div>
        </section>
      </section>

      <section id="viewMovements" class="view-panel hidden">
        <section class="card">
          <div class="card-head"><h2><span class="material-symbols-rounded">receipt_long</span>Movimentos</h2><button id="btnMovementRefresh" class="small-icon" type="button"><span class="material-symbols-rounded">refresh</span></button></div>
          <div class="summary-cards">
            <div class="summary-card blue"><small>Receitas</small><strong id="summaryRevenue">R$ 0,00</strong></div>
            <div class="summary-card red"><small>Despesas</small><strong id="summaryExpense">R$ 0,00</strong></div>
            <div class="summary-card green"><small>Resultado</small><strong id="summaryNet">R$ 0,00</strong></div>
          </div>
          <div id="paymentSummary" class="payment-summary"></div>
          <div id="movementList" class="movement-list"></div>
        </section>
      </section>

      <section id="viewClose" class="view-panel hidden">
        <section class="card close-card">
          <div class="card-head"><h2><span class="material-symbols-rounded">fact_check</span>Fechamento</h2><span id="closeState" class="state-pill">Aberto</span></div>
          <div class="closing-overview">
            <div><small>Inicial</small><strong id="closeOpening">R$ 0,00</strong></div>
            <div><small>Dinheiro +</small><strong id="closeCashRevenue">R$ 0,00</strong></div>
            <div><small>Dinheiro âˆ’</small><strong id="closeCashExpense">R$ 0,00</strong></div>
            <div><small>Sangrias</small><strong id="closeWithdrawals">R$ 0,00</strong></div>
            <div class="wide"><small>Esperado na gaveta</small><strong id="closeExpected">R$ 0,00</strong></div>
          </div>

          <div class="field-grid">
            <label><span class="material-symbols-rounded">payments</span><span>Dinheiro contado</span><input id="countedCash" inputmode="decimal" placeholder="0,00"></label>
            <label><span class="material-symbols-rounded">outbox</span><span>Sangria no fechamento</span><input id="closingWithdrawal" inputmode="decimal" placeholder="0,00"></label>
            <label><span class="material-symbols-rounded">location_on</span><span>Destino</span><input id="closingDestination" placeholder="Financeiro"></label>
            <label class="wide"><span class="material-symbols-rounded">edit_note</span><span>Justificativa / observaÃ§Ã£o</span><textarea id="closingNotes" placeholder="ObrigatÃ³ria somente se houver diferenÃ§a"></textarea></label>
          </div>
          <div class="closing-result"><div><small>DiferenÃ§a</small><strong id="closeDifference">R$ 0,00</strong></div><div><small>FicarÃ¡ no caixa</small><strong id="closeCarryover">R$ 0,00</strong></div></div>
          <label class="declaration"><input type="checkbox" id="closeDeclaration"><span><strong>Conferi e contei o numerÃ¡rio.</strong><small>Confirmo os valores registrados e a eventual sangria.</small></span></label>
          <button id="btnCloseCash" class="primary-action" type="button"><span class="material-symbols-rounded">lock</span><span>Fechar caixa</span></button>
          <div id="closeLinks" class="document-links hidden"></div>
          <div id="closeStatus" class="status-box"></div>
        </section>
      </section>
    </main>
  </div>

  <div id="withdrawalModal" class="modal-backdrop hidden">
    <section class="modal">
      <header><h3><span class="material-symbols-rounded">move_up</span>Sangria</h3><button type="button" data-close="withdrawalModal"><span class="material-symbols-rounded">close</span></button></header>
      <div class="modal-body">
        <div class="withdrawal-balance"><small>DisponÃ­vel</small><strong id="withdrawalAvailable">R$ 0,00</strong></div>
        <label class="modal-field"><span>Valor</span><input id="withdrawalAmount" inputmode="decimal" placeholder="0,00"></label>
        <label class="modal-field"><span>Destino</span><input id="withdrawalDestination" placeholder="Financeiro"></label>
        <label class="modal-field"><span>ObservaÃ§Ã£o</span><textarea id="withdrawalNotes" placeholder="Opcional"></textarea></label>
        <div class="withdrawal-result"><span>RestarÃ¡</span><strong id="withdrawalRemaining">R$ 0,00</strong></div>
        <label class="declaration"><input type="checkbox" id="withdrawalDeclaration"><span><strong>Conferi o valor da sangria.</strong><small>Confirmo que o numerÃ¡rio separado corresponde ao valor informado.</small></span></label>
        <button id="btnSaveWithdrawal" class="danger-action" type="button"><span class="material-symbols-rounded">picture_as_pdf</span><span>Registrar e gerar PDF</span></button>
        <div id="withdrawalStatus" class="status-box"></div>
      </div>
    </section>
  </div>

  <div id="pixModal" class="modal-backdrop hidden">
    <section class="modal pix-modal">
      <header><h3><span class="material-symbols-rounded">qr_code_2</span>Pix</h3><button type="button" data-close="pixModal"><span class="material-symbols-rounded">close</span></button></header>
      <div class="modal-body"><div id="pixAmount" class="pix-amount">R$ 0,00</div><div id="pixQr" class="qr-wrap"></div><textarea id="pixCode" readonly></textarea><div class="modal-actions"><button id="btnCopyPix" class="secondary-action" type="button"><span class="material-symbols-rounded">content_copy</span>Copiar</button><button id="btnConfirmManualPix" class="primary-action" type="button"><span class="material-symbols-rounded">check_circle</span>Confirmar</button></div><div id="pixStatus" class="status-box"></div></div>
    </section>
  </div>

  <div id="settingsModal" class="modal-backdrop hidden">
    <section class="modal"><header><h3><span class="material-symbols-rounded">settings</span>HomologaÃ§Ã£o</h3><button type="button" data-close="settingsModal"><span class="material-symbols-rounded">close</span></button></header><div class="modal-body"><label class="modal-field"><span>URL do Apps Script</span><input id="apiUrlInput" placeholder="Deixe vazio para modo local"></label><button id="btnSaveSettings" class="primary-action" type="button"><span class="material-symbols-rounded">save</span>Salvar</button></div></section>
  </div>

  <div id="loadingOverlay" class="loading-overlay hidden"><div><span class="spinner"></span><strong id="loadingText">Carregando...</strong></div></div>
  <script src="https://cdn.jsdelivr.net/gh/davidshimjs/qrcodejs@master/qrcode.min.js"></script>
  <script src="/caixa-avista/unit-selector.js"></script>
  <script src="/shared/ui/agf-ui.js"></script>
  <script>if('serviceWorker'in navigator)window.addEventListener('load',()=>navigator.serviceWorker.register('/caixa-avista/sw.js').catch(()=>{}));</script>
</body>
</html>
